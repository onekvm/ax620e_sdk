# Boot-stage addresses and eMMC geometry for NanoKVM Pro / AX630C.
# DDR parameters continue to come from the existing eMMC DDR-init package.
ARCH := arm64
PROJECT := AX630C_emmc_arm64_k419_sipeed_nanokvm
FLASH_TYPE := emmc
SUPPPORT_GZIPD := TRUE
SUPPORT_ATF := TRUE
SUPPORT_OPTEE := TRUE
SUPPORT_DDRINIT_PART := TRUE
AX_SUPPORT_AB_PART := TRUE
AX630C_DDR4_RETRAIN := TRUE
AX_BOOT_OPTIMIZATION_SUPPORT := FALSE
AX_SPL_UBOOT_KERNEL_SUPPORT := TRUE

UBOOT_IMG_HEADER_BASE := 0x5c000000
UBOOT_A_HEADER_FLASH_BASE := 0x1c0000
UBOOT_B_HEADER_FLASH_BASE := 0x340000
DDRINIT_PARAM_HEADER_BASE := 0x03200000
DDRINIT_HEADER_FLASH_BASE := 0x0c0000
ATF_IMG_HEADER_BASE := 0x4003fc00
ATF_A_HEADER_FLASH_BASE := 0x140000
ATF_B_HEADER_FLASH_BASE := 0x180000
OPTEE_IMAGE_ADDR := 0x44200000
OPTEE_A_HEADER_FLASH_BASE := 0x11c0000
OPTEE_B_HEADER_FLASH_BASE := 0x12c0000
DTB_IMG_HEADER_ADDR := 0x40000c00
DTB_A_HEADER_FLASH_BASE := 0x13c0000
DTB_B_HEADER_FLASH_BASE := 0x14c0000
KERNEL_IMG_HEADER_ADDR := 0x401ffc00
KERNEL_A_HEADER_FLASH_BASE := 0x15c0000
KERNEL_B_HEADER_FLASH_BASE := 0x55c0000
RAMDISK_START_ADDR := 0
RAMDISK_FLASH_POS := 0
RAWDATA_FLASH_POS := 0
