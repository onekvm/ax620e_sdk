# Standalone SD SPL for the 256 MiB AX620QF NanoKVM Go.
ARCH := arm64
PROJECT := AX620Q_sd_arm64_onekvm_go
FLASH_TYPE := emmc
SUPPPORT_GZIPD := FALSE
SUPPORT_ATF := TRUE
SUPPORT_OPTEE := FALSE
SUPPORT_DDRINIT_PART := FALSE
AX_SUPPORT_AB_PART := FALSE
AX_BOOT_OPTIMIZATION_SUPPORT := FALSE
AX_SPL_UBOOT_KERNEL_SUPPORT := TRUE
AX_SPL_NANOKVM_GO := TRUE
UBOOT_IMG_HEADER_BASE := 0x44000000
UBOOT_A_HEADER_FLASH_BASE := 0
UBOOT_B_HEADER_FLASH_BASE := 0
DDRINIT_PARAM_HEADER_BASE := 0x03200000
DDRINIT_HEADER_FLASH_BASE := 0
ATF_IMG_HEADER_BASE := 0x4003fc00
ATF_A_HEADER_FLASH_BASE := 0
ATF_B_HEADER_FLASH_BASE := 0
DTB_IMG_HEADER_ADDR := 0x42fffc00
DTB_A_HEADER_FLASH_BASE := 0
KERNEL_IMG_HEADER_ADDR := 0x401ffc00
KERNEL_A_HEADER_FLASH_BASE := 0
